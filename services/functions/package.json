{
  "name": "drive-cloud-functions",
  "version": "0.2.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "serve": "npm run build && firebase emulators:start --project demo-drive-local --only auth,firestore,database,functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "seed:demo": "node scripts/seed-config.cjs",
    "grant:admin": "node scripts/grant-admin.cjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "geofire-common": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
