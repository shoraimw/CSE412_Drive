VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Required to preview driver identity documents in authorized browser memory
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Never enable emulators from a public deployed website
VITE_FIREBASE_USE_EMULATORS=false
# Optional public reCAPTCHA Enterprise site key, register first in Firebase App Check
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
