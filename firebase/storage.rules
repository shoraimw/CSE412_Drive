rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function validApplicationFile() {
      return request.resource.size > 0 &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }
    match /applications/{uid}/{filename} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // New objects may be uploaded for a rejected reapplication, but an
      // existing KYC file can NEVER be overwritten by any client. The
      // application stores immutable versioned object names for its review.
      allow create: if resource == null && signedIn() && request.auth.uid == uid &&
        filename.size() < 120 && validApplicationFile();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
